# 赛博女友 · 环境变量说明
#
# 本机自用不需要这个文件 —— 双击「启动.cmd」就行。
# 只有部署到公网时才需要照着填（平台控制台的 Environment 一栏里加）。

# ── 部署形态 ──────────────────────────────────────────────
# 1  = 公网模式：给所有人用。数据按浏览器隔离，API Key 由使用者自带、服务端不落盘。
# 不填 = 本机自用模式。
CG_PUBLIC=1

# 数据目录。平台挂了持久磁盘就指向挂载点。
# 不挂磁盘的话这是个临时目录，容器重启会清空，但浏览器里的 API Key 不受影响。
CG_DATA_DIR=/data

# ── 端口 ──────────────────────────────────────────────────
# Render / Fly / Railway 一般会自己注入 PORT，这里留空就行。
# PORT=3000

# ── 对外网址 ──────────────────────────────────────────────
# 作用是生成「角色形象图」的公网直链（Vivix 服务器要能抓到这张图）。
# 留空 = 按请求头自动推断，正常情况下都能推对，所以一般不用填。
# 如果你挂在 CDN / 自定义域名后面导致推断错了，再填上确切地址，例如：
# PUBLIC_BASE_URL=https://my-girlfriend.onrender.com

# ── 数据清理 ──────────────────────────────────────────────
# 公网实例上每个人一份数据，久了会占满磁盘。
# 超过这些天没人访问的浏览器数据会被自动删掉。
CG_CLIENT_TTL_DAYS=30

# ── 可选的兜底 Key ────────────────────────────────────────
# ⚠️ 强烈建议留空。
# 留空 = 每位使用者在页面上填自己的 Vivix API Key，用多少算他自己头上。
# 一旦在这里填了 Key，就变成「所有人共用你的账户额度」——
# 有人贴到群里被刷，账单是你的。真要填，请配合限额或加访问口令。
# VIVIX_API_KEY=

# ── 本机自用才用得上的 ────────────────────────────────────
# 本机自用时可以设成 1 来禁止自动打开浏览器；公网部署无所谓。
# NO_OPEN=1
# 本机自用时指定只监听某个网卡。
# HOST=0.0.0.0
